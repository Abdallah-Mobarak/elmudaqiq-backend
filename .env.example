# ==========================================================
#  Environment configuration template
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real ".env" file.
# ==========================================================

# App
NODE_ENV=production
PORT=4000
BASE_DOMAIN=api.example.com

# Browser origins allowed to call this API. Comma separated; entries may be
# exact origins or contain one "*" wildcard. Leave unset to accept every origin
# (logged as a warning on boot).
#   ALLOWED_ORIGINS=https://example.com,https://*.example.com
ALLOWED_ORIGINS=

# ----------------------------------------------------------
#  Database (MySQL)
#  connection_limit  -> pool size for the single shared PrismaClient.
#                       Without it Prisma defaults to (cpu_cores * 2 + 1),
#                       which can overrun MySQL's max_connections.
#                       Keep (connection_limit * app instances) < max_connections.
#  pool_timeout      -> seconds to wait for a free connection before P2024.
#  connect_timeout   -> seconds to wait for the initial TCP/handshake.
# ----------------------------------------------------------
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME?connection_limit=10&pool_timeout=20&connect_timeout=10"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"

# ----------------------------------------------------------
#  SMTP / Email
#  Dev/testing:  Mailtrap sandbox (no real delivery)
#  Production:   real SMTP provider (Gmail, SES, etc.)
# ----------------------------------------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL="no-reply@example.com"
